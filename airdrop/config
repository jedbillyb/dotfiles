# Per-machine AirDrop settings for void-btw. Sourced by both
# airdrop-mt7921/airdrop.sh and airdrop-mt7921/daemon/airdropd.
#
# Use ${VAR:-value} assignments, never plain VAR=value: that way a variable
# genuinely set in the environment still overrides what is written here.

# Received files land here rather than ~/Downloads, so AirDrop drops straight
# into the shared mount instead of the home partition.
RECV_DIR="${RECV_DIR:-/mnt/shared/airdrop}"

# Name shown in the iOS share sheet. Without it OpenDrop falls back to
# socket.gethostname() and the phone shows "void-btw", which means nothing to
# anyone being AirDropped to. Kept in step with the Bluetooth advertising name
# in ancs4linux/sv/ancs4linux-advertising/run.
#
# No apostrophe on purpose: OpenDrop substitutes this into an OpenSSL cert
# subject (/CN=<name>) when it generates its TLS identity.
AIRDROP_NAME="${AIRDROP_NAME:-Jeds Linux Laptop}"

# Shortest time opendrop waits on a quiet sender before giving up on an upload
# and salvaging what arrived. opendrop's default floor is 8s, but on this card
# the laptop's TCP ACKs can black out for ~8s mid-transfer while the phone
# keeps retransmitting; on 2026-10-05 an 8s floor cut off a 386KB photo at
# 114KB, one second before the link came back. Exported because opendrop reads
# it from its environment, not from this file.
export AIRDROP_STALL_FLOOR="${AIRDROP_STALL_FLOOR:-20}"

# Channel for the waybar toggle's AirDrop radio (airdropd's P2P-GO). The
# default "auto" copies the laptop's Wi-Fi channel (ch36 at home), but the
# iPhone here sits on the router's 2.4GHz band, where a GO can't run, and with
# its Wi-Fi off it only does AirDrop on ch149/ch6. Measured 2026-10-05: on ch36
# owl heard zero frames from the phone; on ch149 it was discovered. ch36
# station + ch149 GO holds the laptop's Wi-Fi (0% loss).
AIRDROP_GO_CHAN="${AIRDROP_GO_CHAN:-149}"
