# dunst - notification daemon. Styled to match waybar and foot: solid #242424
# at the same 0.85 alpha, #cccccc text, DejaVu Sans Mono.
#
# Notifications come from two places: local apps, and the iPhone over ANCS
# (see "iPhone notifications over Bluetooth" in the README). The rules at the
# bottom are what the waybar notification toggle switches between.

[global]
    monitor = 0
    follow = mouse

    # Line the popup up with the *visible* top-right corner of a tiled window.
    # That corner is at 10px, not 5: sway/config sets `gaps outer 5` AND
    # `default_border pixel 5`, and those borders are fully transparent
    # (client.* colours are #00000000), so 5px of window is invisible and the
    # content starts 10px in. Matching the 5px gap instead makes the popup
    # overhang every window by 5px. Measured against a real foot window:
    # content begins at x = screen_width - 10 and y = 26 (waybar 16 + 10).
    #
    # The vertical offset here is measured from the bottom of waybar's
    # exclusive zone, NOT from the top of the screen - waybar's own 16px is
    # already excluded, so the old `16 + 10 = 26` double-counted the bar and
    # sat a bar-height too low while the right edge stayed correct.
    origin = top-right
    offset = 10x10
    width = (200, 340)
    height = (0, 220)
    notification_limit = 4

    # The default config has none of this, which is why stock dunst looks like
    # text jammed into a coloured box.
    # Equal to horizontal_padding: unequal values make the text sit tighter to
    # one edge than the other, which reads as the whole popup being misaligned
    # even when its outer gaps are pixel-identical.
    padding = 10
    horizontal_padding = 10
    frame_width = 1
    gap_size = 5
    # Square, to match sway's windows. sway draws 5px borders but paints them
    # fully transparent (client.* are all #00000000), so a window is a plain
    # rectangle with hard corners -- a rounded popup sitting over one looked
    # like it came from a different desktop.
    corner_radius = 0
    text_icon_padding = 10

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1

    # 9pt to sit in proportion with waybar, which is 9px. The bar is
    # monospace because it is columns of numbers; notification text is prose,
    # and mono makes it look like terminal output rather than a message.
    font = DejaVu Sans 9
    # 0, not a positive value: line_height adds leading *below* every line,
    # including the last, so anything above 0 quietly adds to the bottom
    # padding only and the box stops looking evenly padded.
    line_height = 0
    markup = full
    # Summary bold, body under it. The app name is added only for phone
    # notifications, by the rule at the bottom -- for local apps it is noise.
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = end
    ignore_newline = no

    # ANCS sends app avatars, which arrive at whatever size iOS felt like.
    # Unbounded, one of those alone is taller than the whole popup.
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 16
    max_icon_size = 28

    show_indicators = false
    # Off: dunst otherwise appends "(4m 38s old)" to anything that has been on
    # screen a while, which is only meaningful for notifications that never
    # expire -- and none of ours should.
    show_age_threshold = -1
    sticky_history = yes
    history_length = 40
    idle_threshold = 120

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#242424"
    foreground = "#777777"
    frame_color = "#3b3b3b"
    timeout = 6

[urgency_normal]
    background = "#242424"
    foreground = "#cccccc"
    frame_color = "#4a4a4a"
    timeout = 10

[urgency_critical]
    background = "#242424"
    foreground = "#cccccc"
    frame_color = "#f7768e"
    # Not 0. dunst's convention is that critical notifications never expire, so
    # they sit on screen until clicked -- a refused pairing then follows you
    # around for the rest of the session. Long enough to be read, then gone.
    timeout = 20

# --- notification modes, driven by scripts/notification-mode.sh ---
#
# dunst applies every matching rule in file order and the last one wins, so
# "mute everything" followed by "except the phone" gives iPhone-only mode.
# There is no way to negate a rule match, which is why it takes two.
#
# ancs4linux sets appname to "<iOS app> (<device name>)", e.g.
# "Messages (Jed's iPhone)" -- that device suffix is the only discriminator.

[mute_local]
    appname = "*"
    skip_display = true
    enabled = false

[allow_iphone]
    appname = "*iPhone*"
    skip_display = false
    enabled = true
    # ancs4linux puts "<iOS app> (<device>)" in appname. Worth showing for a
    # phone notification -- otherwise a message and a bank alert look alike --
    # but small and dim so it stays subordinate to the actual content.
    format = "<span size='x-small' alpha='55%'>%a</span>\n<b>%s</b>\n%b"
