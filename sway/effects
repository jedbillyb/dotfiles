# SwayFX-only visual effects. Included from sway/config, and kept in its own
# file so that falling back to the packaged sway is `rm ~/.config/sway/effects`
# rather than an edit: stock sway rejects every command in here and nags about
# it on every start.
#
# Values are aimed at macOS rather than at maximum effect. macOS is
# conservative here - a 10px corner, a soft wide shadow, and blur only behind
# things that are actually translucent - and overshooting any of them is what
# makes a Linux desktop read as "themed" rather than as macOS.

# Animations. SwayFX 0.6 animates window open, close, resize, move and
# workspace change off this single duration. macOS window animations sit around
# 200ms - long enough to read as motion, short enough that it never feels like
# waiting - so this is deliberately below SwayFX's own 250ms default.
animation_duration_ms 200

# macOS window corners are 10px at 1x. smart_corner_radius drops the rounding
# when a window is the only one on screen, which is wrong here: a lone maximised
# macOS window still has rounded corners.
corner_radius 10
smart_corner_radius disable

# Blur is what the whole exercise is for: Zed's theme is already translucent, so
# with blur behind it the editor finally reads as frosted glass rather than as a
# window someone turned the opacity down on.
blur enable
blur_passes 2
blur_radius 5
# xray blurs the wallpaper only, ignoring windows underneath. macOS blurs
# whatever is actually behind the window, so this stays off.
blur_xray disable
blur_brightness 0.9
blur_contrast 1.0
blur_saturation 1.1

# The menu bar is a layer-shell surface, so it needs naming separately. This is
# what turns the translucent slab in waybar's stylesheet into a frosted one.
layer_effects "waybar" blur enable; blur_ignore_transparent enable

shadows enable
shadow_blur_radius 24
shadow_offset 0 6
shadow_color #00000066
shadow_inactive_color #00000040
