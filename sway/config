# sway config — ported from i3

# ── Variables ─────────────────────────────────────────────────────────────────

set $mod Mod4

# ── Appearance ────────────────────────────────────────────────────────────────

font pango:monospace 8

# Borders are the drag handle for touch resizing -- with `border none` there is
# no hit region for a finger to grab, so tiled windows can only be resized from
# the keyboard. These are invisible ones: fully transparent, because sway
# alpha-blends border colours over the wallpaper layer.
#
# The 5px they cost comes out of inner gaps rather than out of the windows, so
# this is pixel-identical to the old borderless 10px-gap layout: same content
# sizes, same 10px everywhere.
#
# Every gap has to stay the same width, and that pins the border to half a gap.
# A window's rect cannot extend past the output and outer gaps clamp there, so
# the screen-edge inset always equals the border width, while the gutter
# between two windows is two borders. Equal gaps therefore means
# outer == border and gutter == 2 * border, i.e. a 10px look caps the border at
# 5. Widening the grab strip means widening every gap to match -- border 10
# plus outer 10 gives 20px throughout.
#
# 10px is a fifth of a fingertip on this screen, so dragging a border is fiddly
# by touch. The 2-finger resize gestures in touch-gestures.sh are the way round
# that: they need no aiming at all.
default_border pixel 5
default_floating_border pixel 5
focus_on_window_activation none
floating_modifier $mod normal

gaps inner 0
gaps outer 5

#                       border    background text    indicator child_border
client.focused          #00000000 #00000000  #ffffff #00000000 #00000000
client.focused_inactive #00000000 #00000000  #888888 #00000000 #00000000
client.unfocused        #00000000 #00000000  #888888 #00000000 #00000000

# ── Output / Wallpaper ────────────────────────────────────────────────────────

output * bg /mnt/shared/wallpapers/garrett-parker-unsplash.jpg fill

# ── Idle / Lock ───────────────────────────────────────────────────────────────

exec /home/jed/.local/bin/sway-idle.sh

# Keep waybar rendering above the lock screen. Render-only: the lock still
# blocks all input to it, and still survives a locker crash. Requires the
# patched sway from /mnt/shared/projects/sway-lockbar.
lock_visible_namespace waybar

# ── Autostart ─────────────────────────────────────────────────────────────────

# Hand the session environment to D-Bus, so activated services inherit it.
# Without this they start with no WAYLAND_DISPLAY, and xdg-desktop-portal-gtk
# exits 1 on startup because GTK cannot open a display. The portal frontend
# then silently drops the FileChooser interface altogether, and every file
# dialog fails with "missing xdg-desktop-portal implementation". Must run
# before anything that might trigger portal activation.
exec dbus-update-activation-environment --all

exec nm-applet --indicator
exec blueman-applet

# Fingerprint-gated Bluetooth pairing agent. Must come after blueman-applet:
# whichever agent calls RequestDefaultAgent last wins, and this one re-asserts
# the claim on a timer so a restart of blueman cannot silently take pairing
# back. See "iPhone notifications over Bluetooth" in the README for why neither
# ancs4linux's agent nor blueman's is good enough here.
exec /mnt/shared/projects/dotfiles/scripts/bt-pair-agent.py

# The pairing agent asks for the passkey in a foot window. Float and centre it
# so it lands on top of whatever you are doing rather than tiling into the
# layout, where it is easy to miss while the phone waits.
exec dunst

# amdgpu_bl0 doesn't reset to max on boot; force it so the screen isn't dim on login
exec_always brightnessctl set 100%
# exec_always, not exec: a plain exec only runs at sway startup, so if the
# server ever dies every footclient window dies with it and $mod+Return stops
# working until a full restart. A second copy just exits, the socket is taken.
exec_always foot --server
exec pipewire
exec pipewire-pulse
exec wireplumber
exec udiskie

# Spiral/dwindle tiling: auto-split along the longer edge of the focused window
exec_always autotiling

# AirPods battery for the bar. Safe under exec_always: the daemon takes an
# flock and a second copy exits immediately on reload.
exec_always /mnt/shared/projects/waybar-airpods/daemon/airpodsd

# noted - shared note: local cache poller + wallpaper-layer widget
exec_always /mnt/shared/projects/noted/local/noted-sync.sh
exec_always python3 /mnt/shared/projects/noted/desktop/noted-barbg.py
# Guard loop (not exec_always+kill) so a crashed eww respawns without
# needing a sway reload, and boots reliably on login.
exec_always /mnt/shared/projects/noted/local/eww-guard.sh
bindsym $mod+n exec /mnt/shared/projects/noted/local/noted-quickadd.sh

# Discord Rich Presence for LibreOffice. Plain exec, not exec_always: the
# daemon has no single-instance lock, so a reload would stack a second copy.
exec /mnt/shared/projects/libreoffice-discord-rpc/.venv/bin/libreoffice-discord-rpc

# iPhone notifications over BLE (ANCS). The observer and advertising daemons
# are supervised by runit as root; this one is the session-bus half that turns
# the notifications into dunst popups, so it belongs in the sway session.
# Plain exec: it holds a bus name, and a reload would stack a second copy.
exec /mnt/shared/projects/ancs4linux/.venv/bin/ancs4linux-desktop-integration

# Escape dismisses the quick-add bar. A binding mode only captures the keys
# bound in it, so typing still reaches the input.
mode "noted" {
    bindsym Escape exec /mnt/shared/projects/noted/local/noted-quickadd.sh close
    bindsym $mod+n exec /mnt/shared/projects/noted/local/noted-quickadd.sh close
}

# ── Workspaces ────────────────────────────────────────────────────────────────

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ── Applications ──────────────────────────────────────────────────────────────

bindsym $mod+Return exec footclient
bindsym $mod+r      exec $HOME/.local/bin/spotlight
bindsym $mod+p      exec Thunar

# ── System ────────────────────────────────────────────────────────────────────

bindsym $mod+Shift+v exec $HOME/.local/bin/vpn-toggle.sh
bindsym $mod+Shift+c exec $HOME/.local/bin/caffeine-toggle.sh
bindsym $mod+Shift+i exec /home/jed/.local/bin/sway-lock.sh
bindsym $mod+Shift+o exec swaymsg exit
bindsym $mod+Shift+p exec loginctl poweroff
# Also re-probes the touchpad, which wakes up wedged after suspend.
bindsym $mod+Shift+r reload, exec sudo /usr/libexec/elogind/system-sleep/touchpad-resume-fix.sh, exec $HOME/.local/bin/wifi-recover.sh

# ── Media ─────────────────────────────────────────────────────────────────────

bindsym XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+ && notify-send -t 800 "Vol: $(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
bindsym XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%- && notify-send -t 800 "Vol: $(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
bindsym XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioNext         exec playerctl next
bindsym XF86AudioPrev         exec playerctl previous
bindsym XF86AudioPlay         exec playerctl play-pause
bindsym XF86AudioStop         exec playerctl stop
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ── Screenshots ───────────────────────────────────────────────────────────────

bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy
bindsym --to-code grave exec mkdir -p /mnt/shared/pictures/Screenshots && f="/mnt/shared/pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png" && grim "$f" && notify-send -t 1200 "Screenshot saved" "$f"
bindsym --to-code Shift+grave exec mkdir -p /mnt/shared/pictures/Screenshots && f="/mnt/shared/pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png" && grim -c "$f" && notify-send -t 1200 "Screenshot saved (cursor)" "$f"

# ── Window Management ─────────────────────────────────────────────────────────

bindsym $mod+q kill

bindsym $mod+h split h
bindsym $mod+f       exec firefox
bindsym $mod+c       exec google-chrome-stable
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+d       exec $HOME/.local/bin/show-desktop.sh

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space       exec $HOME/.local/bin/spotlight
bindsym $mod+grave       focus mode_toggle
bindsym $mod+a           focus parent

# focus
bindsym $mod+j         focus left
bindsym $mod+k         focus down
bindsym $mod+l         focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left      focus left
bindsym $mod+Down      focus down
bindsym $mod+Up        focus up
bindsym $mod+Right     focus right

# move
bindsym $mod+Shift+j         move left
bindsym $mod+Shift+k         move down
bindsym $mod+Shift+l         move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left      move left
bindsym $mod+Shift+Down      move down
bindsym $mod+Shift+Up        move up
bindsym $mod+Shift+Right     move right

# ── Resize Mode ───────────────────────────────────────────────────────────────

mode "resize" {
    bindsym j         resize shrink width 10 px
    bindsym k         resize grow height 10 px
    bindsym l         resize shrink height 10 px
    bindsym semicolon resize grow width 10 px

    bindsym Left  resize shrink width 10 px
    bindsym Down  resize grow height 10 px
    bindsym Up    resize shrink height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+Shift+d mode "resize"

# ── Bar ───────────────────────────────────────────────────────────────────────

# Supervised so a waybar crash brings the bar straight back. The script is
# safe to run again on reload -- it hands over to the existing supervisor
# rather than starting a second one.
exec_always ~/.local/bin/waybar-run.sh

# Hide/show the bar. Normally that is just waybar's visibility toggle -- the
# process stays alive, so the supervisor above leaves a hidden bar alone -- but
# if the bar has crashed and stayed down, the same key brings it back instead
# of signalling a process that is not there.
bindsym $mod+b exec ~/.local/bin/waybar-toggle.sh

# ── Input ─────────────────────────────────────────────────────────────────────

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# The touchpad exposes two input nodes from the one piece of hardware -- a
# "Touchpad" (multitouch) and a legacy "Mouse" (relative pointer) -- and both
# report BTN_LEFT. The kernel binds hid-generic first and hands over to
# hid-multitouch at boot, which normally leaves the Mouse collection inert, but
# a mid-session rebind (the $mod+Shift+r recovery) does not always reproduce
# that. When both go live every physical click lands twice and the touchpad
# reads as permanently double-clicking. The Touchpad node carries BTN_LEFT
# itself, so nothing is lost by silencing the duplicate.
input "1160:4177:CRQ1080:00_0488:1051_Mouse" events disabled

# Touchscreen gestures. sway's own bindgesture only fires on libinput gesture
# events, which touchscreens never emit, so the swipes come from lisgd instead.
# Needs the udev rule at /etc/udev/rules.d/99-touchscreen-lisgd.rules.
exec_always $HOME/.local/bin/touch-gestures.sh

# Touch shield: strips along the gesture edges that take the swipe so the app
# underneath does not also get it. DISABLED -- unfinished, see "Stopping the
# swipe from also hitting the app" in the dotfiles README. The catching works;
# handing a tap back to the app works exactly once and then the strips go
# permanently input-transparent, so it is inert rather than harmful, but there
# is no point running it until that is fixed.
# exec_always $HOME/.local/bin/touch-shield.py
