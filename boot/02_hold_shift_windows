#!/bin/sh
# /etc/grub.d/02_hold_shift_windows: hold Shift while powering on to boot
# straight into Windows, without catching the hidden 1s GRUB window.
# keystatus only works if the firmware reports modifier keys; where it
# doesn't, this does nothing and Esc / F12 / reboot-windows still work.
# The title must match the entry 30_os-prober makes, so it is built the same
# way from os-prober's output.
dev=$(os-prober 2>/dev/null | grep ':Windows Boot Manager:' | head -1 | cut -d@ -f1)
[ -n "$dev" ] || exit 0
cat <<GRUB
if keystatus --shift; then
  set default="Windows Boot Manager (on $dev)"
  set timeout=0
fi
GRUB
