{
    "position": "top",
    "height": 16,
    "layer": "overlay",
    "exclusive": true,
    "modules-left": ["sway/workspaces", "custom/calendar", "custom/claude"],
    "modules-center": ["clock"],
    "modules-right": ["custom/caffeine", "custom/vpn", "custom/usbwifi", "custom/network", "pulseaudio", "memory", "cpu", "temperature", "battery"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "memory": {
        "format": "ram {percentage}%",
        "interval": 5,
        "tooltip": false
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "format": "temp {temperatureC}°C",
        "critical-threshold": 90,
        "format-critical": "temp {temperatureC}°C",
        "interval": 5,
        "tooltip": false
    },

    "custom/claude": {
        "exec": "~/.config/waybar/claude-status.sh",
        "return-type": "json",
        "interval": 10,
        "signal": 10,
        "tooltip": true
    },

    "custom/calendar": {
        "exec": "CAL_GCAL_DIR=/mnt/shared/projects/waybar-gcal ~/.config/waybar/calendar-status.sh",
        "return-type": "json",
        "interval": 10,
        "tooltip": true
    },

    "custom/network": {
        "exec": "~/.config/waybar/network-status.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": false
    },

    "custom/vpn": {
        "exec": "~/.config/waybar/vpn-status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "tooltip": false
    },

    "custom/usbwifi": {
        "exec": "~/.config/waybar/usbwifi-status.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": false
    },

    "custom/caffeine": {
        "exec": "~/.config/waybar/caffeine-status.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "~/.local/bin/caffeine-toggle.sh",
        "tooltip": false
    },

    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "bat+ {capacity}%",
        "format-full": "bat full",
        "interval": 30,
        "tooltip": false
    }
}
