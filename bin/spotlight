#!/bin/bash
# Spotlight-style launcher: wofi centered on the focused output, dismissed by
# clicking or tapping away from it.
#
# bash rather than sh only for `wait -n`: the launcher ends when *either* wofi
# or the backdrop does, and POSIX sh can only wait for a named process.

BW=520
BH=340

read -r W H <<EOF
$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | "\(.rect.width) \(.rect.height)"')
EOF

# Fallback if we couldn't read the geometry
[ -n "$W" ] && [ -n "$H" ] || { W=1920; H=1200; }

X=$(( (W - BW) / 2 ))
Y=$(( (H - BH) / 2 ))

BACKDROP=$HOME/.local/bin/wofi-backdrop.py
DISMISS=$HOME/.local/bin/wofi-dismiss.py

# Clicking away is caught by a transparent full-screen surface underneath the
# launcher, because there is no way to ask where a click went: pointers report
# relative motion, sway's IPC has no cursor position, and its focus events do
# not fire for the window you were already on. See wofi-backdrop.py.
#
# It has to start *before* wofi. Both are layer-shell surfaces on the same
# layer, and within a layer the newer one stacks on top, so starting it first is
# what puts it above every window but below the launcher.
if [ -x "$BACKDROP" ]; then
    "$BACKDROP" &
    BD=$!
fi

wofi --show drun \
    --width "$BW" --height "$BH" \
    --location top_left --xoffset "$X" --yoffset "$Y" &
WOFI=$!

# Tapping away is caught separately, by reading the touchscreen and comparing
# against the box. Kept as well as the backdrop because it needs nothing of the
# compositor beyond the evdev node, so it still works if the layer ordering ever
# shifts under us -- and it is the path that was proven first.
if [ -x "$DISMISS" ]; then
    "$DISMISS" "$X" "$Y" "$BW" "$BH" "$W" "$H" "$WOFI" &
    WATCHER=$!
fi

# Whichever ends first ends the lot: wofi exiting means a pick or Escape, the
# backdrop exiting means you clicked away.
wait -n "$WOFI" ${BD:+"$BD"}
kill "$WOFI" ${BD:+"$BD"} ${WATCHER:+"$WATCHER"} 2>/dev/null
wait "$WOFI" 2>/dev/null
