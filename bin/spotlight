#!/bin/sh
# Spotlight-style launcher: wofi centered on the focused output.
# wofi 1.5.3's location=center is broken here, so compute offsets ourselves.

BW=520
BH=340

read -r W H <<EOF
$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | "\(.rect.width) \(.rect.height)"')
EOF

# Fallback if we couldn't read the geometry
[ -n "$W" ] && [ -n "$H" ] || { W=1920; H=1200; }

X=$(( (W - BW) / 2 ))
Y=$(( (H - BH) / 2 ))

wofi --show drun \
    --width "$BW" --height "$BH" \
    --location top_left --xoffset "$X" --yoffset "$Y" &
WOFI=$!

# Tap anywhere outside the box to dismiss it, like tapping off a dialog. wofi
# has no option for this and it cannot be done through sway either: wofi takes
# keyboard focus as a layer surface, so a tap elsewhere raises no focus event --
# and on an empty workspace, which is exactly when you reach for a launcher,
# there would be no other window to focus anyway. So the watcher reads the
# touchscreen directly, and needs the rectangle computed above.
DISMISS=$HOME/.local/bin/wofi-tap-dismiss.py
if [ -x "$DISMISS" ] && [ -r /dev/input/touchscreen ]; then
    "$DISMISS" "$X" "$Y" "$BW" "$BH" "$W" "$H" "$WOFI" &
    WATCHER=$!
fi

wait "$WOFI"
STATUS=$?
[ -n "$WATCHER" ] && kill "$WATCHER" 2>/dev/null
exit "$STATUS"
