#!/bin/sh
# Spotlight-style launcher: wofi centered on the focused output.
# wofi 1.5.3's location=center is broken here, so compute offsets ourselves.

BW=520
BH=340

read -r W H <<EOF
$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | "\(.rect.width) \(.rect.height)"')
EOF

# Fallback if we couldn't read the geometry
[ -n "$W" ] && [ -n "$H" ] || { W=1920; H=1200; }

X=$(( (W - BW) / 2 ))
Y=$(( (H - BH) / 2 ))

exec wofi --show drun \
    --width "$BW" --height "$BH" \
    --location top_left --xoffset "$X" --yoffset "$Y"
