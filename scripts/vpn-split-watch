#!/usr/bin/env python3
"""Live view of which traffic is riding the VPN and which is going out direct.

    vpn-split-watch [interval]      default 2s, Ctrl-C to quit

Two panels, answering different questions:

  RATES   bytes/sec down each path. awg0's counters are the decrypted inner
          traffic; the direct figure is the physical interface minus awg0, so
          the tunnel's own encrypted packets land in the same subtraction.
          Read it as "is anything material leaving in the clear", not as an
          exact count - it never reads zero.

  FLOWS   every established connection, with the path the kernel will actually
          use, asked of the routing table per destination. This is the
          authoritative half. DIRECT rows sort first.

The HOST column is the real TLS SNI wherever possible: a tcpdump sniffs
ClientHello messages on every interface and maps address -> hostname, so you get
"www.youtube.com" rather than a bare 142.x. This is needed because neither of
the cheap alternatives works. Reverse DNS is useless for exactly the addresses
that matter (Google publishes no PTR for its frontends, and Microsoft service
IPs mostly have none either), and passive DNS sniffing sees nothing because
Firefox and Chrome both resolve over DoH.

SNI is only visible when a connection is NEW, so a long-lived flow that
handshook before this started will not have one. Those fall back to the label
table below, then to PTR, so a row is never blank forever.

With the Microsoft 365 split in place, Teams/Outlook/SharePoint/Office and Entra
sign-in should read DIRECT and everything else VPN. See awg-split-update.
"""
import ipaddress, os, shutil, socket, struct, subprocess, sys, threading, time
from concurrent.futures import ThreadPoolExecutor

VPN_IF = "awg0"

# Display labels only. These do NOT drive routing - the kernel does, and the
# PATH column asks it directly. They exist so a screen full of bare 52.x
# addresses is readable. Ranges match awg-split-update's exclusion set.
LABELS = [
    ("52.112.0.0/14",   "Microsoft Teams"),
    ("52.122.0.0/15",   "Microsoft Teams"),
    ("52.96.0.0/14",    "Outlook/Exchange"),
    ("40.96.0.0/13",    "Outlook/Exchange"),
    ("40.104.0.0/15",   "Outlook/Exchange"),
    ("132.245.0.0/16",  "Outlook/Exchange"),
    ("23.103.160.0/20", "Outlook/Exchange"),
    ("52.104.0.0/14",   "SharePoint/OneDrive"),
    ("40.108.128.0/17", "SharePoint/OneDrive"),
    ("104.146.128.0/17","SharePoint/OneDrive"),
    ("52.108.0.0/14",   "Office web apps"),
    ("20.190.128.0/18", "Microsoft sign-in"),
    ("40.126.0.0/18",   "Microsoft sign-in"),
    ("20.20.32.0/19",   "Microsoft sign-in"),
    ("20.231.128.0/19", "Microsoft sign-in"),
    ("13.107.0.0/16",   "Microsoft (Front Door)"),
    ("150.171.0.0/16",  "Microsoft (Front Door)"),
    ("152.69.172.0/24", "your OCI server"),
    ("10.0.2.0/24",     "VPN internal"),
]
LABELS = [(ipaddress.ip_network(n), t) for n, t in LABELS]

route_cache, host_cache = {}, {}
sni_map = {}                       # address -> hostname, from observed ClientHellos
pool = ThreadPoolExecutor(max_workers=16)


def plausible_hostname(name):
    """Reject anything that is not a DNS name.

    The capture filter matches any TCP segment whose first payload byte is 0x16,
    so mid-stream data can look enough like a ClientHello to parse. When it does,
    the walk lands on arbitrary bytes and returns a fragment - a stray "wo" once
    replaced a correctly labelled Teams row. A real SNI is a hostname, so demand
    one rather than trusting the parse.
    """
    if not 4 <= len(name) <= 253 or "." not in name:
        return False
    if name[0] in ".-" or name[-1] in ".-":
        return False
    if not all(c.isalnum() or c in ".-" for c in name):
        return False
    # A real name ends in a TLD. This is what rejects a ClientHello that was cut
    # in half by the segment boundary: "upload.offi" parses fine and has a dot,
    # but "offi" is not a TLD, so the prefix does not survive.
    labels = name.split(".")
    return len(labels) >= 2 and len(labels[-1]) >= 2 and labels[-1].isalpha()


def sni_from_tls(payload):
    """Hostname out of a TLS ClientHello, or None. Deliberately total: a
    malformed or truncated capture must never take the display down."""
    if len(payload) < 9 or payload[0] != 0x16 or payload[5] != 0x01:
        return None
    # Cross-check the record and handshake lengths against each other. A genuine
    # ClientHello agrees with itself; a coincidental 0x16 almost never does.
    rec_len = struct.unpack(">H", payload[3:5])[0]
    hs_len = int.from_bytes(payload[6:9], "big")
    if not 4 <= rec_len <= 16384 or hs_len + 4 != rec_len:
        return None
    try:
        i = 5 + 4 + 2 + 32                                  # hdr + version + random
        i += 1 + payload[i]                                 # session id
        i += 2 + struct.unpack(">H", payload[i:i + 2])[0]   # cipher suites
        i += 1 + payload[i]                                 # compression methods
        end = i + 2 + struct.unpack(">H", payload[i:i + 2])[0]
        i += 2
        while i + 4 <= end:
            etype, elen = struct.unpack(">HH", payload[i:i + 4])
            i += 4
            if etype == 0:                                  # server_name
                if payload[i + 2] != 0:                     # name_type: host_name
                    return None
                n = struct.unpack(">H", payload[i + 3:i + 5])[0]
                # A big ClientHello can span two segments, and slicing past the
                # end yields a silent PREFIX of the real hostname - which is
                # where "uploa" came from. Demand the whole name or nothing.
                if i + 5 + n > len(payload):
                    return None
                name = payload[i + 5:i + 5 + n].decode("ascii", "replace")
                return name if plausible_hostname(name) else None
            i += elen
    except Exception:
        return None
    return None


def sni_watcher():
    """Fill sni_map from ClientHellos on every interface.

    -i any so this sees both sides at once: the decrypted inner traffic on awg0
    and anything going out direct on the physical link. Tunnelled flows also
    appear on the physical link as WireGuard, but that is encrypted and yields
    no SNI, so there is nothing to de-duplicate.
    """
    cmd = ["sudo", "tcpdump", "-i", "any", "-nn", "-s", "0", "-U", "-w", "-", "-q",
           "tcp port 443 and (tcp[((tcp[12:1]&0xf0)>>2)]=22)"]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except Exception:
        return
    header = proc.stdout.read(24)
    if len(header) < 24:
        return
    endian = "<" if header[:4] in (b"\xd4\xc3\xb2\xa1", b"\x4d\x3c\xb2\xa1") else ">"
    # The link-layer header size comes from the pcap link type, never from
    # guessing. Scanning the packet for a 0x4x nibble instead looks like it
    # works - "any" happens to be 20 bytes so SLL2 lands right - but on plain
    # Ethernet it false-matches inside the payload and silently finds nothing.
    linktype = struct.unpack(endian + "I", header[20:24])[0]
    ll_offset = {1: 14, 101: 0, 113: 16, 276: 20}.get(linktype)
    if ll_offset is None:
        return
    while True:
        rec = proc.stdout.read(16)
        if len(rec) < 16:
            return
        caplen = struct.unpack(endian + "IIII", rec)[2]
        pkt = proc.stdout.read(caplen)
        if len(pkt) < ll_offset + 20 or pkt[ll_offset] >> 4 != 4:
            continue                      # not IPv4; VLAN tags and v6 land here
        ip = pkt[ll_offset:]
        ihl = (ip[0] & 0xF) * 4
        if len(ip) < ihl + 20:
            continue
        dst = ".".join(str(b) for b in ip[16:20])
        toff = ihl + ((ip[ihl + 12] >> 4) * 4)
        name = sni_from_tls(ip[toff:])
        if name:
            sni_map[dst] = name


def phys_iface():
    out = run(["ip", "route", "show", "default"])
    for tok in out.split():
        if tok == "dev":
            return out.split()[out.split().index("dev") + 1]
    return None


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


def counter(iface, which):
    try:
        with open(f"/sys/class/net/{iface}/statistics/{which}") as f:
            return int(f.read())
    except OSError:
        return 0


def human(b):
    for unit, div in (("MB/s", 1 << 20), ("kB/s", 1 << 10)):
        if b >= div:
            return "%7.1f %s" % (b / div, unit)
    return "%7d  B/s" % b


def path_for(ip):
    """Which interface the kernel will use. Cached; ip route get is a syscall."""
    if ip not in route_cache:
        out = run(["ip", "route", "get", ip]).split()
        dev = out[out.index("dev") + 1] if "dev" in out else ""
        route_cache[ip] = "VPN" if dev == VPN_IF else "DIRECT"
    return route_cache[ip]


def label_for(ip):
    addr = ipaddress.ip_address(ip)
    for net, text in LABELS:
        if addr in net:
            return text
    return None


def host_for(ip):
    """Observed SNI first, then the label table, then PTR.

    SNI is checked on every call rather than cached, because it can arrive after
    the row was first drawn - a flow shows its label until its ClientHello is
    seen, then sharpens to the real hostname.
    """
    if ip in sni_map:
        return sni_map[ip]
    if ip in host_cache:
        return host_cache[ip]
    known = label_for(ip)
    if known:
        host_cache[ip] = known
        return known
    host_cache[ip] = ""                       # placeholder while it resolves
    def resolve():
        try:
            host_cache[ip] = socket.gethostbyaddr(ip)[0]
        except Exception:
            host_cache[ip] = "-"
    pool.submit(resolve)
    return ""


def flows():
    out = run(["sudo", "ss", "-tunpH", "state", "established"])
    seen = []
    for line in out.splitlines():
        f = line.split()
        if len(f) < 5:
            continue
        peer = f[4]
        proc = f[5] if len(f) > 5 else ""
        addr, _, port = peer.rpartition(":")
        addr = addr.strip("[]")
        if not addr or addr == "*":
            continue
        name = ""
        if '"' in proc:
            name = proc.split('"')[1]
        seen.append((path_for(addr), addr, port, name))
    # DIRECT first: those are the rows worth looking at.
    return sorted(set(seen), key=lambda r: (r[0] != "DIRECT", r[1]))


def main():
    interval = float(sys.argv[1]) if len(sys.argv) > 1 else 2.0
    ph = phys_iface()
    if not ph:
        sys.exit("no default route; is the network up?")

    threading.Thread(target=sni_watcher, daemon=True).start()

    prev_v = counter(VPN_IF, "rx_bytes") + counter(VPN_IF, "tx_bytes")
    prev_p = counter(ph, "rx_bytes") + counter(ph, "tx_bytes")
    print("\033[?25l", end="")
    try:
        while True:
            time.sleep(interval)
            if not os.path.exists(f"/sys/class/net/{VPN_IF}"):
                print("\033[H\033[2J  %s is DOWN - everything is going out direct." % VPN_IF)
                continue

            now_v = counter(VPN_IF, "rx_bytes") + counter(VPN_IF, "tx_bytes")
            now_p = counter(ph, "rx_bytes") + counter(ph, "tx_bytes")
            rate_v = int((now_v - prev_v) / interval)
            rate_d = max(0, int((now_p - prev_p - (now_v - prev_v)) / interval))
            prev_v, prev_p = now_v, now_p

            hs = run(["sudo", "awg", "show", VPN_IF, "latest-handshakes"]).split()
            age = int(time.time()) - int(hs[1]) if len(hs) > 1 and hs[1] != "0" else None
            state = f"handshake {age}s ago" if age is not None else "NO HANDSHAKE"

            rows = flows()
            direct = [r for r in rows if r[0] == "DIRECT"]
            tunnel = [r for r in rows if r[0] != "DIRECT"]

            # Both halves have to stay visible. Sorting DIRECT first and then
            # cutting at a fixed 30 meant a busy Office session pushed every
            # tunnelled row off the bottom, so the panel silently stopped
            # answering the only question it exists to answer.
            budget = max(10, shutil.get_terminal_size((100, 40)).lines - 10)
            keep_t = min(len(tunnel), max(4, budget // 3))
            keep_d = min(len(direct), budget - keep_t)
            keep_t = min(len(tunnel), budget - keep_d)

            out = ["\033[H\033[2J",
                   f"  VPN {VPN_IF} ({state})   direct via {ph}\n",
                   f"  RATES   through VPN: {human(rate_v)}      direct: {human(rate_d)}\n",
                   f"  FLOWS   {len(direct)} direct (outside the VPN)"
                   f"      {len(tunnel)} through the tunnel\n",
                   "  %-7s %-16s %-6s %-14s %s" % ("PATH", "REMOTE", "PORT", "PROCESS", "HOST / SERVICE"),
                   "  %-7s %-16s %-6s %-14s %s" % ("-" * 7, "-" * 16, "-" * 6, "-" * 14, "-" * 30)]

            def block(rs, keep, total):
                for path, addr, port, proc in rs[:keep]:
                    out.append("  %-7s %-16s %-6s %-14s %s"
                               % (path, addr, port, proc or "?", host_for(addr)))
                if total > keep:
                    out.append("  %-7s ... %d more not shown" % ("", total - keep))

            block(direct, keep_d, len(direct))
            out.append("")
            block(tunnel, keep_t, len(tunnel))
            print("\n".join(out))
    except KeyboardInterrupt:
        pass
    finally:
        print("\033[?25h", end="")


if __name__ == "__main__":
    main()
