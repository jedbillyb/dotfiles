#!/bin/bash
# Roll AmneziaWG clients on/off awg0 - live, no interface restart, existing
# peers untouched. Runs ON THE OCI SERVER (152.69.172.139) as root; deployed to
# /usr/local/bin/awg-client. This copy is the source of truth in dotfiles.
#
#   awg-client add <name> [--ip A.B.C.D] [--split] [--json|--file]
#                           generate keys, allocate an IP (lowest free, or the
#                           one named by --ip), add the peer live, and print the
#                           config + a scannable QR. Config goes to stdout,
#                           QR/chatter to stderr, so
#                           `ssh oci sudo awg-client add NAME > NAME.conf` grabs
#                           a clean config. --file drops NAME.conf (0600) beside
#                           you instead - handy for scp to a Windows box.
#                           --json emits one machine-readable object instead.
#                           --split routes Microsoft 365 outside the tunnel (see
#                           awg-split-update). Off by default: a full tunnel is
#                           the safe assumption, and the dashboard always says
#                           which it wants explicitly.
#   awg-client list [--json]  show configured peers, IPs, handshake, transfer
#   awg-client del <name>     remove the peer live and from the config file
#   awg-client flows          read-only split-tunnel audit: for every tunnel
#                           IP with live conntrack entries, how many of its
#                           flows are headed outside the split list. Zero on a
#                           split client is the proof the split is working -
#                           see awg-flows for the reasoning.
#   awg-client egress ...     per-client public IP: list/alloc/release/apply.
#                           Hands straight off to the root helper at
#                           /usr/local/lib/awg-dash/egress.py, which owns the
#                           OCI API calls and the SNAT chain; see its header.
#
# The tunnel rides UDP/123 with the message-type headers reshaped (H1-H4) and
# junk disabled (Jc/S1/S2=0) to clear the N4L school filter - see the header of
# ~/.local/bin/vpn-amnezia.sh on the laptop for the full why. Every client MUST
# carry these exact params or its packets won't match the server interface.
#
# The peer is added with `awg set ... peer`, NOT syncconf/addconf: that touches
# only the one peer and never re-applies (or resets) the interface obfuscation
# params, so an add can't knock the other family members offline.
#
# The generated config holds the client PRIVATE KEY. It is printed to the
# terminal and never written to disk, so there is nothing to shred afterwards.
# Scan the QR straight into the AmneziaWG app, or copy the text into a .conf on
# the client and delete it once imported.
#
# This is also the ONLY privileged entry point used by the awg-dashboard web UI
# (/mnt/shared/projects/awg-dashboard), which runs unprivileged as `awgdash` and
# reaches root solely through a sudoers rule naming this script. Every argument
# is therefore validated here rather than by the caller.
set -euo pipefail

CONF=/etc/amnezia/amneziawg/awg0.conf
IFACE=awg0
EGRESS_HELPER=/usr/local/lib/awg-dash/egress.py
FLOWS_HELPER=/usr/local/bin/awg-flows
# The OCI SDK only exists inside the CLI's virtualenv, so the helper is run with
# that interpreter when it is present and the system one otherwise - the helper
# degrades to "no new allocations" rather than failing outright.
EGRESS_PYTHON=/opt/oci-cli/bin/python3
# Microsoft 365 split tunnel. Regenerated by awg-split-update; absent means a
# plain full tunnel, so a failed or never-run update degrades to today's
# behaviour rather than breaking provisioning. See that script for the why.
SPLIT_FILE=/etc/awg-dash/split-allowedips.txt
ENDPOINT=152.69.172.139:123
DNS=1.1.1.1
SUBNET=10.0.2                       # /24; .1 is the server
# AmneziaWG obfuscation params - MUST match the awg0 interface exactly.
JC=0 JMIN=8 JMAX=80 S1=0 S2=0 H1=27 H2=36 H3=37 H4=35

die() { echo "awg-client: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "run as root (sudo awg-client ...)"
[[ -f "$CONF" ]] || die "$CONF not found"

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; }

# The AllowedIPs value for a new client config: the split list if one has been
# generated, otherwise a full tunnel. Only ever affects configs made from here
# on - AllowedIPs lives in the client's own file, and this script keeps no copy
# of a client's private key, so existing peers cannot be re-issued without a
# new keypair.
client_allowed_ips() {
    [[ "${1:-full}" == "split" ]] || { echo "0.0.0.0/0"; return; }
    local list=""
    if [[ -s "$SPLIT_FILE" ]]; then
        list=$(grep -vE '^[[:space:]]*(#|$)' "$SPLIT_FILE" | paste -sd, -)
    fi
    # A file holding only comments is non-empty but yields nothing, and an empty
    # AllowedIPs would route the client nowhere at all. Fall back rather than
    # hand out a config that cannot carry traffic. Warn, because the caller
    # asked for a split and is not getting one.
    if [[ -z "$list" ]]; then
        echo "awg-client: no split list at $SPLIT_FILE, issuing a full tunnel" >&2
        echo "0.0.0.0/0"
    else
        echo "$list"
    fi
}

# Escape a blob for embedding in a JSON string. Peer names are already
# restricted to [a-zA-Z0-9._-] and keys are base64, so newline/quote/backslash
# cover everything that can actually appear; the rest is defensive.
json_escape() {
    awk 'BEGIN{ORS=""} { gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); print (NR>1?"\\n":"") $0 }'
}

# Host octets already spoken for in the config, one per line.
used_octets() {
    grep -E '^AllowedIPs' "$CONF" \
        | sed -nE "s#^AllowedIPs = ${SUBNET//./\\.}\.([0-9]+)/.*#\1#p"
}

# Peer blocks are "[Peer] / # name / PublicKey / AllowedIPs"; the comment can be
# on any line of the block, so scan the whole paragraph rather than assume $1.
peer_pubkey() {
    awk -v t="# $1" 'BEGIN{RS="";FS="\n"}
        { has=0; for(i=1;i<=NF;i++) if($i==t) has=1
          if(has) for(i=1;i<=NF;i++) if($i ~ /^PublicKey/){
              sub(/PublicKey[ ]*=[ ]*/,"",$i); print $i } }' "$CONF"
}

# Emit "name<TAB>ip<TAB>pubkey" per configured peer, config order.
peer_rows() {
    awk 'BEGIN{RS="";FS="\n"}
        { isp=0; name=""; ip=""; pub=""
          for(i=1;i<=NF;i++){
              if($i ~ /^\[Peer\]/) isp=1
              if($i ~ /^# /){ n=$i; sub(/^# /,"",n); name=n }
              if($i ~ /^PublicKey/){ p=$i; sub(/PublicKey[ ]*=[ ]*/,"",p); pub=p }
              if($i ~ /^AllowedIPs/){ a=$i; sub(/AllowedIPs[ ]*=[ ]*/,"",a); ip=a }
          }
          if(isp && pub!="") print name "\t" ip "\t" pub }' "$CONF"
}

do_add() {
    local name="" tofile=0 asjson=0 want_ip="" mode=full priv pub ip used n
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --file) tofile=1 ;;
            --json) asjson=1 ;;
            --split) mode=split ;;
            --full)  mode=full ;;
            --ip)   [[ $# -ge 2 ]] || die "--ip needs an address"
                    want_ip="$2"; shift ;;
            --ip=*) want_ip="${1#--ip=}" ;;
            -*)     die "unknown flag: $1" ;;
            *)      [[ -z "$name" ]] && name="$1" || die "one name only" ;;
        esac
        shift
    done
    [[ -n "$name" ]] || die "usage: awg-client add <name> [--ip A.B.C.D] [--json|--file]"
    valid_name "$name" || die "name: letters, digits, . _ - only"
    [[ $tofile -eq 1 && $asjson -eq 1 ]] && die "--file and --json are mutually exclusive"
    # --file writes a root-owned 0600 file into the caller's cwd, which is not
    # something an unattended caller (the dashboard) should ever trigger.
    [[ $tofile -eq 1 && ! -t 0 ]] && die "--file needs an interactive terminal"
    grep -qx "# $name" "$CONF" && die "peer '$name' already exists"

    used=$(used_octets)
    if [[ -n "$want_ip" ]]; then
        # Explicit allocation, for the dashboard's IP planner. Must be a host in
        # our own /24, never the server, never already taken.
        [[ "$want_ip" =~ ^${SUBNET//./\.}\.([0-9]{1,3})$ ]] \
            || die "--ip must be an address in ${SUBNET}.0/24"
        n="${BASH_REMATCH[1]}"
        (( n >= 2 && n <= 254 )) || die "--ip host octet must be 2-254 (.1 is the server)"
        grep -qx "$n" <<<"$used" && die "$want_ip is already assigned"
        ip="$want_ip"
    else
        # Lowest free host in the /24, skipping the server (.1) and taken IPs.
        ip=""
        for n in $(seq 2 254); do
            grep -qx "$n" <<<"$used" && continue
            ip="${SUBNET}.${n}"; break
        done
        [[ -n "$ip" ]] || die "no free address in ${SUBNET}.0/24"
    fi

    priv=$(awg genkey)
    pub=$(awg pubkey <<<"$priv")

    # Live add first - surgical, one peer, no restart, no param reset.
    awg set "$IFACE" peer "$pub" allowed-ips "${ip}/32"
    # Then persist so it survives an awg-quick down/up, matching the existing
    # block style ([Peer] first, then the naming comment).
    #
    # If persisting fails - a read-only /etc (systemd ProtectSystem=strict bit
    # us here), a full disk - roll the live add back. Otherwise the interface
    # ends up with a peer the config file has never heard of, which `list` and
    # the dashboard would both then report as untracked drift.
    # Subshell so the shell's own "cannot open" message is captured too, not
    # just the command's - otherwise it leaks past 2>/dev/null into whatever is
    # parsing our output.
    if ! ( printf '\n[Peer]\n# %s\nPublicKey = %s\nAllowedIPs = %s/32\n' \
           "$name" "$pub" "$ip" >> "$CONF" ) 2>/dev/null; then
        awg set "$IFACE" peer "$pub" remove 2>/dev/null || true
        die "could not write $CONF - live add rolled back, no peer created"
    fi

    local cfg allowed
    allowed=$(client_allowed_ips "$mode")
    cfg=$(cat <<EOF
[Interface]
PrivateKey = ${priv}
Address = ${ip}/32
DNS = ${DNS}
Jc = ${JC}
Jmin = ${JMIN}
Jmax = ${JMAX}
S1 = ${S1}
S2 = ${S2}
H1 = ${H1}
H2 = ${H2}
H3 = ${H3}
H4 = ${H4}

[Peer]
PublicKey = $(awg show "$IFACE" public-key)
Endpoint = ${ENDPOINT}
AllowedIPs = ${allowed}
PersistentKeepalive = 25
EOF
)
    # --json is the dashboard's path: one object on stdout, nothing else, so the
    # caller never has to parse human text. It carries the private key, exactly
    # like the stdout config does, and is likewise never written to disk here.
    if [[ $asjson -eq 1 ]]; then
        # `split` reports what was ACTUALLY issued, which is not always what was
        # asked for: a missing list downgrades to a full tunnel. The dashboard
        # records this value, so its display can never drift from the config.
        local issued=false
        [[ "$allowed" != "0.0.0.0/0" ]] && issued=true
        printf '{"name":"%s","ip":"%s","pubkey":"%s","split":%s,"config":"%s"}\n' \
            "$name" "$ip" "$pub" "$issued" "$(printf '%s\n' "$cfg" | json_escape)"
        return
    fi
    # --file writes the config beside you (root 0600) for scp to a desktop.
    # Otherwise the config goes to stdout ALONE - all chatter and the QR go to
    # stderr - so `ssh oci sudo awg-client add NAME > NAME.conf` captures a clean
    # config with no noise, and a terminal user still sees the QR to scan.
    if [[ $tofile -eq 1 ]]; then
        local out="${name}.conf"
        ( umask 077; printf '%s\n' "$cfg" > "$out" )
        echo "Added '$name' as ${ip} (live + persisted)." >&2
        echo "Wrote $(readlink -f "$out") (0600) - scp it, import, then delete it." >&2
    else
        echo "Added '$name' as ${ip} (live + persisted)." >&2
        echo >&2
        echo "$cfg"                                                          # stdout: clean config
        echo >&2
        echo "=== scan into the AmneziaWG app (App Store id6478942365 / Play Store) ===" >&2
        qrencode -t ANSIUTF8 <<<"$cfg" >&2                                   # QR to stderr
    fi
}

do_del() {
    local name="$1" pub tmp
    valid_name "$name" || die "name: letters, digits, . _ - only"
    grep -qx "# $name" "$CONF" || die "no peer named '$name'"

    pub=$(peer_pubkey "$name")
    [[ -n "$pub" ]] && awg set "$IFACE" peer "$pub" remove

    # Drop the paragraph whose block carries "# name", keep everything else.
    tmp=$(mktemp)
    awk -v t="# $name" 'BEGIN{RS="";FS="\n";ORS=""}
        { has=0; for(i=1;i<=NF;i++) if($i==t) has=1
          if(has) next
          print sep $0; sep="\n\n" } END{print "\n"}' "$CONF" >"$tmp"
    cat "$tmp" >"$CONF"          # preserve file owner/mode
    rm -f "$tmp"
    echo "Removed '$name'." >&2
}

# `awg show <if> dump` gives pubkey/psk/endpoint/allowed-ips/handshake/rx/tx/
# keepalive in one shot, so live state costs a single call rather than one per
# peer. Line 1 is the interface itself; skip it.
dump_field() {
    # `|| true` so a down interface degrades to "no live data" instead of
    # aborting under `set -e pipefail` - the dashboard must still be able to
    # list configured peers while awg0 is down.
    { awg show "$IFACE" dump 2>/dev/null || true; } \
        | awk -v k="$1" -v f="$2" 'NR>1 && $1==k{print $f}'
}

do_list() {
    local asjson=0
    [[ "${1:-}" == "--json" ]] && asjson=1

    if [[ $asjson -eq 1 ]]; then
        local first=1 name ip pub hs rx tx ep
        printf '['
        while IFS=$'\t' read -r name ip pub; do
            [[ -z "$pub" ]] && continue
            ep=$(dump_field "$pub" 3);  hs=$(dump_field "$pub" 5)
            rx=$(dump_field "$pub" 6);  tx=$(dump_field "$pub" 7)
            ip="${ip%%/*}"          # bare address; the store keys on /32-less IPs
            [[ $first -eq 1 ]] || printf ','
            first=0
            printf '{"name":"%s","ip":"%s","pubkey":"%s","endpoint":"%s","handshake":%s,"rx":%s,"tx":%s}' \
                "$name" "$ip" "$pub" "${ep:-}" "${hs:-0}" "${rx:-0}" "${tx:-0}"
        done < <(peer_rows)
        printf ']\n'
        return
    fi

    printf '%-18s %-12s %s\n' NAME IP HANDSHAKE
    local now; now=$(date +%s)
    peer_rows | while IFS=$'\t' read -r name ip pub; do
        hs=$(dump_field "$pub" 5)
        if [[ -n "$hs" && "$hs" != "0" ]]; then
            when="$(( (now - hs) / 60 ))m ago"
        else
            when="never"
        fi
        printf '%-18s %-12s %s\n' "$name" "$ip" "$when"
    done
}

# Read-only: parses the kernel's conntrack table and reports, per tunnel IP,
# how many live flows are headed somewhere the split list does NOT cover. See
# the header of awg-flows for why that is the whole test.
do_flows() {
    [[ -x "$FLOWS_HELPER" ]] || die "flows helper not installed at $FLOWS_HELPER"
    exec "$FLOWS_HELPER" "$@"
}

do_egress() {
    [[ -x "$EGRESS_HELPER" ]] || die "egress helper not installed at $EGRESS_HELPER"
    local py=$EGRESS_PYTHON
    [[ -x "$py" ]] || py=$(command -v python3) || die "no python3"
    exec "$py" "$EGRESS_HELPER" "$@"
}

case "${1:-}" in
    add)    shift; do_add "$@" ;;
    del)    [[ $# -eq 2 ]] || die "usage: awg-client del <name>"; do_del "$2" ;;
    list)   shift; do_list "${1:-}" ;;
    egress) shift; do_egress "$@" ;;
    flows)  shift; do_flows "$@" ;;
    *)      die "usage: awg-client add <name> [--ip A.B.C.D] [--json|--file] | list [--json] | del <name> | egress list|alloc|release|apply | flows" ;;
esac
