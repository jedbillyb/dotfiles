#!/usr/bin/env python3
"""Every open pull request across your own GitHub repos, in one place.

GitHub has no single view of "PRs sitting in things I own". The notifications
inbox goes quiet once you have read a thing, /pulls only shows PRs you opened
or were explicitly asked to review, and a repo you have not touched in months
never surfaces at all. That is how #12 and #13 on linux-fingerprint-drivers sat
for four days and three days.

Three searches, merged and de-duplicated by URL:

  owned            open PRs in any repo you own, from anyone
  authored         open PRs you opened, anywhere
  review-requested open PRs where you are on the reviewer list, anywhere

Usage:
  gh-prs                 grouped listing (default)
  gh-prs --count         number waiting on you, for scripts
  gh-prs --waybar        one JSON object for a waybar custom module
  gh-prs --json          the merged, annotated PR list
  gh-prs --web           open the equivalent GitHub search in a browser
  gh-prs --refresh       bypass the cache
  gh-prs --all           include your own PRs and drafts in the listing

Results are cached for 5 minutes in $XDG_CACHE_HOME/gh-prs so the waybar module
and the terminal command share one set of API calls.
"""

import argparse
import calendar
import json
import os
import shutil
import subprocess
import sys
import time
import webbrowser
from pathlib import Path

TTL = 300
TIMEOUT = 25
FIELDS = "number,title,repository,author,createdAt,updatedAt,url,isDraft,labels,commentsCount"

CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "gh-prs"
CACHE_FILE = CACHE_DIR / "prs.json"


class GhError(RuntimeError):
    pass


def gh(*args):
    """Run gh and return parsed stdout. Raises GhError with a usable message."""
    try:
        p = subprocess.run(
            ("gh",) + args, capture_output=True, text=True, timeout=TIMEOUT
        )
    except FileNotFoundError:
        raise GhError("gh is not installed")
    except subprocess.TimeoutExpired:
        raise GhError("gh timed out")
    if p.returncode != 0:
        err = (p.stderr or "").strip().splitlines()
        msg = err[-1] if err else f"gh exited {p.returncode}"
        if "auth" in msg.lower() or "logged" in msg.lower():
            raise GhError("gh is not authenticated (run: gh auth login)")
        raise GhError(msg)
    return p.stdout


def whoami():
    return os.environ.get("GH_PRS_OWNER") or gh("api", "user", "--jq", ".login").strip()


def search(owner, *filters):
    out = gh(
        "search", "prs", "--state", "open", "--limit", "100",
        "--json", FIELDS, *filters,
    )
    return json.loads(out or "[]")


def fetch(owner):
    """The three searches, merged into one annotated list keyed by URL."""
    buckets = {
        "owned": ["--owner", owner],
        "authored": ["--author", owner],
        "requested": ["--review-requested", "@me"],
    }
    merged = {}
    for tag, flags in buckets.items():
        try:
            rows = search(owner, *flags)
        except GhError:
            # One failing search should not lose the other two. A user with no
            # review requests at all is the common case here.
            continue
        for pr in rows:
            entry = merged.setdefault(pr["url"], dict(pr, tags=[]))
            entry["tags"].append(tag)

    prs = []
    for pr in merged.values():
        repo = pr.get("repository") or {}
        author = (pr.get("author") or {}).get("login") or "?"
        pr["repo"] = repo.get("nameWithOwner") or repo.get("name") or "?"
        pr["repo_short"] = repo.get("name") or pr["repo"]
        pr["login"] = author
        pr["mine"] = author.lower() == owner.lower()
        pr["in_my_repo"] = pr["repo"].split("/")[0].lower() == owner.lower()
        pr["draft"] = bool(pr.get("isDraft"))
        # Waiting on you: somebody else's PR in a repo you own, or anywhere
        # your review was explicitly requested. Drafts are not waiting on
        # anyone yet.
        pr["waiting"] = (not pr["draft"]) and (
            (pr["in_my_repo"] and not pr["mine"])
            or ("requested" in pr["tags"] and not pr["mine"])
        )
        prs.append(pr)

    prs.sort(key=lambda p: p.get("createdAt") or "")
    return prs


def load(refresh=False):
    """Cached fetch. Returns (prs, age_seconds, error_or_None)."""
    cached, cached_age = None, None
    if CACHE_FILE.exists():
        try:
            blob = json.loads(CACHE_FILE.read_text())
            cached = blob.get("prs")
            cached_age = time.time() - blob.get("ts", 0)
        except (OSError, ValueError):
            cached = None

    if cached is not None and not refresh and cached_age is not None and cached_age < TTL:
        return cached, cached_age, None

    try:
        prs = fetch(whoami())
    except GhError as exc:
        # Offline or unauthenticated: show the stale list rather than nothing,
        # and let the caller colour it as stale.
        if cached is not None:
            return cached, cached_age, str(exc)
        return [], None, str(exc)

    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"ts": time.time(), "prs": prs}))
        tmp.replace(CACHE_FILE)
    except OSError:
        pass
    return prs, 0, None


def ago(iso):
    if not iso:
        return "?"
    try:
        t = calendar.timegm(time.strptime(iso, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return "?"
    s = max(0, int(time.time() - t))
    for size, suffix in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= size:
            return f"{s // size}{suffix}"
    return f"{s}s"


C = {
    "reset": "\033[0m", "dim": "\033[90m", "bold": "\033[1m",
    "amber": "\033[33m", "blue": "\033[34m", "green": "\033[32m",
}


def paint(text, *names):
    if not sys.stdout.isatty():
        return text
    return "".join(C[n] for n in names) + text + C["reset"]


def clip(text, width):
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def render(prs, show_all, age, error):
    waiting = [p for p in prs if p["waiting"]]
    mine = [p for p in prs if p["mine"] and not p["draft"]]
    drafts = [p for p in prs if p["draft"]]

    groups = [("waiting on you", waiting, "amber")]
    if show_all:
        groups += [("opened by you", mine, "blue"), ("drafts", drafts, "dim")]

    if not any(rows for _, rows, _ in groups):
        print(paint("no open pull requests waiting on you", "dim"))
        if not show_all and (mine or drafts):
            extra = len(mine) + len(drafts)
            print(paint(f"{extra} of your own open (gh-prs --all)", "dim"))
        return

    cols = shutil.get_terminal_size((100, 24)).columns
    for title, rows, colour in groups:
        if not rows:
            continue
        print()
        print(paint(f"{title} ({len(rows)})", "bold", colour))
        print()
        rw = max(len(f"{p['repo_short']} #{p['number']}") for p in rows)
        aw = max(len(p["login"]) for p in rows)
        # One title column for the whole group, so the author and age columns
        # line up and the eye can run straight down them.
        room = max(20, min(cols - rw - aw - 14, max(len(p["title"]) for p in rows)))
        for p in rows:
            head = f"{p['repo_short']} #{p['number']}".ljust(rw)
            who = p["login"].ljust(aw)
            old = ago(p.get("createdAt"))
            print(
                f"  {paint(head, 'bold')}  {clip(p['title'], room).ljust(room)}"
                f"  {paint(who, 'dim')} {paint(old.rjust(4), 'dim')}"
            )
    print()
    if error:
        print(paint(f"showing cached results: {error}", "dim"))
    elif age and age > 60:
        print(paint(f"cached {ago_seconds(age)} ago", "dim"))


def ago_seconds(s):
    s = int(s)
    for size, suffix in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= size:
            return f"{s // size}{suffix}"
    return f"{s}s"


def waybar(prs, age, error):
    """One JSON object for a waybar custom module.

    Silent when nothing is waiting: an empty text plus the "none" class lets
    the stylesheet collapse the module, the same trick the calendar and claude
    modules use, so the bar does not carry a permanent "pr 0".
    """
    waiting = [p for p in prs if p["waiting"]]
    if error and not prs:
        return {"text": "pr ?", "class": "error", "tooltip": error}

    if not waiting:
        return {"text": "", "class": "none"}

    lines = [
        f"{p['repo_short']} #{p['number']}  {clip(p['title'], 58)}"
        f"  ({p['login']}, {ago(p.get('createdAt'))})"
        for p in waiting
    ]
    cls = "review"
    # Anything untouched for a week is the failure this module exists to stop,
    # so it gets its own colour rather than blending in with a fresh one.
    if any(ago(p.get("createdAt")).endswith("d") and int(ago(p["createdAt"])[:-1]) >= 7
           for p in waiting):
        cls = "stale"
    if error:
        cls = "error"
        lines.append("")
        lines.append(f"stale: {error}")
    return {"text": f"pr {len(waiting)}", "class": cls, "tooltip": "\n".join(lines)}


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.split("\n")[0])
    ap.add_argument("--count", action="store_true", help="print the waiting count only")
    ap.add_argument("--waybar", action="store_true", help="emit waybar JSON")
    ap.add_argument("--json", action="store_true", dest="as_json", help="emit the PR list")
    ap.add_argument("--web", action="store_true", help="open the GitHub search instead")
    ap.add_argument("--refresh", action="store_true", help="ignore the cache")
    ap.add_argument("--all", action="store_true", help="include your own PRs and drafts")
    args = ap.parse_args()

    if args.web:
        owner = os.environ.get("GH_PRS_OWNER")
        if not owner:
            try:
                owner = whoami()
            except GhError as exc:
                print(exc, file=sys.stderr)
                return 1
        url = f"https://github.com/search?q=is%3Aopen+is%3Apr+user%3A{owner}&type=pullrequests"
        webbrowser.open(url)
        return 0

    prs, age, error = load(refresh=args.refresh)

    if args.waybar:
        print(json.dumps(waybar(prs, age, error)))
        return 0
    if args.count:
        print(sum(1 for p in prs if p["waiting"]))
        return 0
    if args.as_json:
        print(json.dumps(prs, indent=2))
        return 0

    if error and not prs:
        print(error, file=sys.stderr)
        return 1
    render(prs, args.all, age, error)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
