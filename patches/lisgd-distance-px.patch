 	ActMode actmode;
 	char *command;
+	/* An exact minimum travel in pixels, written in the distance field instead
+	 * of S/M/L. Zero means unused. The buckets are thirds of the screen, which
+	 * is far too coarse to place a guard: on a 1200px-tall screen the only
+	 * choices for a downward swipe are "any" and "at least 396px", with nothing
+	 * in between, and a comfortable deliberate swipe here measures about 280.
+	 *
+	 * Last on purpose. The defaults in config.h are positional initialisers, so
+	 * a field added anywhere earlier shifts every one of them; here they simply
+	 * leave it zero-filled, which is the "unused" value. */
+	double distancepx;
